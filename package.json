{
  "name": "colacop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json",
    "migrate": "tsx scripts/migrate.ts",
    "seed:fixtures": "tsx scripts/seed-fixtures.ts",
    "seed:demo": "tsx scripts/seed-fixtures.ts agave cointreau rumble",
    "lint": "eslint .",
    "test": "vitest run",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web",
    "build:web": "vite build",
    "start:server": "tsx src/server/index.ts",
    "start:worker": "tsx src/worker/index.ts"
  },
  "dependencies": {
    "@google/genai": "^1.51.0",
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "kysely": "^0.27.4",
    "multer": "^2.1.1",
    "pg": "^8.13.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
